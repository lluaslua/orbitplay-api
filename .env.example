# ───────────────────────── OrbitPlay API — variáveis de ambiente ─────────────────────────
# Copie para .env. NUNCA suba o .env para o repositório. Em produção (NODE_ENV=production)
# a API se recusa a subir se o JWT_SECRET for fraco, o CORS for "*", o gateway for "sandbox"
# ou as URLs públicas não forem https.

# Ambiente: development | test | production
NODE_ENV=development

# Porta e prefixo casam com o VITE_API_URL do app (http://localhost:3333/api).
PORT=3333
API_PREFIX=api

# Origens liberadas no CORS, separadas por vírgula. Nunca use "*".
# "null" é a origem que o Electron manda quando a página roda em file:// — em produção
# deixe só se o app desktop empacotado precisar (e saiba que é um risco documentado).
CORS_ORIGINS=http://localhost:5173,null

# Quantos proxies/balanceadores confiáveis ficam na frente da API (0 = nenhum).
# Necessário para o rate limit enxergar o IP real (X-Forwarded-For). Errar para mais
# permite forjar IP; errar para menos faz todos parecerem um IP só.
TRUST_PROXY_HOPS=0

# Postgres. Troque SUA_SENHA. Em produção use TLS (?sslmode=require) e um usuário sem superpoderes.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/orbitplay?schema=public"

# OBRIGATÓRIO. 32+ caracteres aleatórios: `openssl rand -base64 48`. Trocar invalida todas as sessões.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Duração da sessão: sem "Lembrar login" (12 h) e com ele (30 dias).
JWT_EXPIRES_IN_SECONDS=43200
JWT_REMEMBER_EXPIRES_IN_SECONDS=2592000

# Senhas: custo do bcrypt (10 a 15; padrão 12). Hashes mais fracos são refeitos no login.
BCRYPT_COST=12
# Bloqueio de conta por força bruta: falhas seguidas e minutos de bloqueio.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Limite global de requisições por IP por minuto (cada rota sensível tem o seu, mais estrito).
RATE_LIMIT_GLOBAL_PER_MINUTE=600
# Só para testes automatizados. Nunca "true" em produção.
RATE_LIMIT_DISABLED=false

# Pasta onde builds, vídeos e imagens enviados ficam. Em produção, fora do diretório da aplicação,
# com backup, e `private/` nunca exposta por servidor web.
STORAGE_DIR=storage

# Tamanho máximo de uma build enviada, em MB.
BUILD_MAX_SIZE_MB=4096

# "sandbox" confirma o pagamento na hora — SÓ para desenvolvimento. Em produção use um gateway real.
PAYMENT_PROVIDER=sandbox
# Segredo HMAC-SHA256 do webhook de pagamento (o provedor assina o corpo; sem segredo, webhook é recusado).
# `openssl rand -hex 32`. Tolerância do carimbo da assinatura, em segundos:
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Só para staging: permite PAYMENT_PROVIDER=sandbox com NODE_ENV=production. Nunca em produção real.
# ALLOW_SANDBOX_PAYMENTS=false

# Endereço do app, usado no link de redefinição de senha (https em produção).
APP_URL=http://localhost:5173

# Endereço público da API, base das URLs de imagens. Padrão: http://localhost:PORT/API_PREFIX
# Em produção: https://api.seudominio.com/api
# PUBLIC_API_URL=http://localhost:3333/api

# O seed apaga o banco e cria contas de demonstração (senha 123456): bloqueado em produção.
# ALLOW_SEED_IN_PRODUCTION=false
