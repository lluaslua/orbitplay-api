# Porta e prefixo casam com o VITE_API_URL do app (http://localhost:3333/api).
PORT=3333
API_PREFIX=api

# Origens liberadas no CORS, separadas por virgula.
# "null" e a origem que o Electron manda quando a pagina roda em file://.
CORS_ORIGINS=http://localhost:5173,null

# Postgres local. Troque SUA_SENHA pela senha do usuario postgres.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/orbitplay?schema=public"

# Obrigatorio - a API nao sobe sem ele. Troque fora da sua maquina.
JWT_SECRET=troque-este-segredo

# Duracao da sessao: sem "Lembrar login" (12 h) e com ele (30 dias).
JWT_EXPIRES_IN_SECONDS=43200
JWT_REMEMBER_EXPIRES_IN_SECONDS=2592000

# Pasta onde builds, videos e imagens enviados ficam guardados.
STORAGE_DIR=storage

# Tamanho maximo de uma build enviada, em MB.
BUILD_MAX_SIZE_MB=4096

# "sandbox" confirma o pagamento na hora. Troque quando houver um gateway de verdade.
PAYMENT_PROVIDER=sandbox

# Endereco do app, usado no link de redefinicao de senha.
APP_URL=http://localhost:5173

# Endereco publico da API, base das URLs de imagens e videos. Padrao: http://localhost:PORT/API_PREFIX
# PUBLIC_API_URL=http://localhost:3333/api
