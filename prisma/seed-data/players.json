  "sessionReview": {
    "id": "88565",
    "gameId": "game-101",
    "testName": "Pista São Paulo v1.3",
    "testKind": "DEMO ABERTA",
    "rewardCents": 250,
    "testsDone": 4,
    "transcript": [
      {
        "at": "00:21",
        "text": "Ok… acho que esse salto era pra ser mais intuitivo. Demorei um pouco pra entender o timing."
      },
      {
        "at": "01:46",
        "text": "Travou tudo aqui… tive que frear do nada. Achei que o jogo tinha congelado."
      },
      {
        "at": "02:12",
        "text": "Caramba, essa curva é muito boa! Dá uma sensação de velocidade absurda."
      },
      {
        "at": "05:15",
        "text": "Tá difícil demais pra uma corrida inicial. Acho que isso podia ser mais suave no começo."
      },
      {
        "at": "05:58",
        "text": "O som do motor tá legal, mas quando eu bato ele some por um segundo."
      },
      {
        "at": "07:45",
        "text": "Bati em algo invisível? Não vi nada na pista."
      },
      {
        "at": "09:32",
        "text": "Já tô meio cansado… talvez a corrida esteja longa demais."
      },
      {
        "at": "10:37",
        "text": "No geral é bem divertido. Se ajustar essas coisas, fica excelente."
      }
    ]
  },
